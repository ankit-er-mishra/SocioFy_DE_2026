    CITIES ||--o{ BOOKINGS : "executed_in"

    SERVICE_CATEGORIES ||--o{ SERVICES : "classifies"
    SERVICE_CATEGORIES ||--o{ PRO_SKILLS : "qualifies"

    PROFESSIONALS ||--o{ PRO_SKILLS : "certified_for"
    PROFESSIONALS ||--o{ PRO_AVAILABILITY : "publishes"
